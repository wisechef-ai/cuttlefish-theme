+  const live = new Set([...knownSessions(v.feed), id])
+  for (const k of [...m.keys()]) if (!live.has(k)) m.delete(k)
+  for (const k of [...live].sort()) if (!m.has(k)) m.set(k, allocate(k, [...m.values()]).slot)
+  return hueOfSlot(m.get(id) as number)
