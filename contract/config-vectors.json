{
  "_doc": "ACCEPTANCE CONTRACT (locked). Shared by desktop/test/acceptance/o2_config.test.ts and tests/acceptance/test_o5_live_config.py. Each case: input -> expect (a deep SUBSET of the resolved settings) + warnings (exact set of [path, code]). Codes: type | range | enum | unknown | missing | required. A rejected field keeps its default; a rejected NEW state or pattern is dropped whole.",
  "defaults": {
    "intensity": 1,
    "motion": "still",
    "states": {
      "resting":         {"when": "idle",        "pattern": "mottle",  "priority": 0,   "label": ""},
      "working":         {"when": "busy",        "pattern": "clouds",  "priority": 60,  "label": "working"},
      "needs_you":       {"when": "needs_input", "pattern": "zebra",   "priority": 100, "label": "needs you"},
      "error":           {"when": "failed",      "pattern": "blanch",  "priority": 80,  "label": "error"},
      "finished_unseen": {"when": "unseen",      "pattern": "eyespot", "priority": 40,  "label": "done"}
    },
    "patterns": {
      "mottle":  {"base": "mottle",  "density": 1, "contrast": 1, "scale": 1},
      "clouds":  {"base": "clouds",  "density": 1, "contrast": 1, "scale": 1},
      "zebra":   {"base": "zebra",   "density": 1, "contrast": 1, "scale": 1},
      "blanch":  {"base": "blanch",  "density": 1, "contrast": 1, "scale": 1},
      "eyespot": {"base": "eyespot", "density": 1, "contrast": 1, "scale": 1}
    }
  },
  "ranges": {"intensity": [0, 2], "density": [0.25, 4], "contrast": [0, 2], "scale": [0.25, 4], "priority": [-1000, 1000], "label_max_len": 24},
  "cases": [
    {"name": "empty is the defaults", "input": {}, "expect": {}, "warnings": [], "exact_defaults": true},
    {"name": "null settings", "input": null, "expect": {}, "warnings": [], "exact_defaults": true},
    {"name": "settings must be a mapping", "input": "loud", "expect": {"intensity": 1}, "warnings": [["settings", "type"]]},
    {"name": "a list is not a mapping", "input": [1, 2], "expect": {"motion": "still"}, "warnings": [["settings", "type"]]},
    {"name": "intensity in range", "input": {"intensity": 1.5}, "expect": {"intensity": 1.5}, "warnings": []},
    {"name": "intensity zero switches the field off", "input": {"intensity": 0}, "expect": {"intensity": 0}, "warnings": []},
    {"name": "intensity below range", "input": {"intensity": -1}, "expect": {"intensity": 1}, "warnings": [["intensity", "range"]]},
    {"name": "intensity above range", "input": {"intensity": 3}, "expect": {"intensity": 1}, "warnings": [["intensity", "range"]]},
    {"name": "intensity wrong type", "input": {"intensity": "high"}, "expect": {"intensity": 1}, "warnings": [["intensity", "type"]]},
    {"name": "a boolean is not a number", "input": {"intensity": true}, "expect": {"intensity": 1}, "warnings": [["intensity", "type"]]},
    {"name": "motion alive", "input": {"motion": "alive"}, "expect": {"motion": "alive"}, "warnings": []},
    {"name": "motion off", "input": {"motion": "off"}, "expect": {"motion": "off"}, "warnings": []},
    {"name": "motion unknown", "input": {"motion": "wild"}, "expect": {"motion": "still"}, "warnings": [["motion", "enum"]]},
    {"name": "remap a preset's pattern", "input": {"states": {"needs_you": {"pattern": "mottle"}}},
     "expect": {"states": {"needs_you": {"when": "needs_input", "pattern": "mottle", "priority": 100, "label": "needs you"}}}, "warnings": []},
    {"name": "add a state", "input": {"states": {"compacting": {"when": "compacting", "pattern": "zebra", "priority": 50, "label": "compacting"}}},
     "expect": {"states": {"compacting": {"when": "compacting", "pattern": "zebra", "priority": 50, "label": "compacting"}, "working": {"pattern": "clouds"}}}, "warnings": []},
    {"name": "a new state's label defaults to its name", "input": {"states": {"subagents": {"when": "subagents", "pattern": "clouds", "priority": 55}}},
     "expect": {"states": {"subagents": {"label": "subagents"}}}, "warnings": []},
    {"name": "new state with an unknown signal is dropped", "input": {"states": {"x": {"when": "nope", "pattern": "zebra", "priority": 5}}},
     "expect": {}, "absent": ["states.x"], "warnings": [["states.x.when", "enum"]]},
    {"name": "new state with an unknown pattern is dropped", "input": {"states": {"x": {"when": "busy", "pattern": "plaid", "priority": 5}}},
     "expect": {}, "absent": ["states.x"], "warnings": [["states.x.pattern", "unknown"]]},
    {"name": "new state without priority is dropped", "input": {"states": {"x": {"when": "busy", "pattern": "zebra"}}},
     "expect": {}, "absent": ["states.x"], "warnings": [["states.x.priority", "missing"]]},
    {"name": "a bad field on a preset keeps that field's default", "input": {"states": {"needs_you": {"priority": "high"}}},
     "expect": {"states": {"needs_you": {"priority": 100, "pattern": "zebra"}}}, "warnings": [["states.needs_you.priority", "type"]]},
    {"name": "priority out of range", "input": {"states": {"working": {"priority": 5000}}},
     "expect": {"states": {"working": {"priority": 60}}}, "warnings": [["states.working.priority", "range"]]},
    {"name": "label too long", "input": {"states": {"working": {"label": "this label is far too long for a strip"}}},
     "expect": {"states": {"working": {"label": "working"}}}, "warnings": [["states.working.label", "range"]]},
    {"name": "null removes a preset", "input": {"states": {"working": null}},
     "expect": {}, "absent": ["states.working"], "warnings": []},
    {"name": "resting cannot be removed", "input": {"states": {"resting": null}},
     "expect": {"states": {"resting": {"pattern": "mottle"}}}, "warnings": [["states.resting", "required"]]},
    {"name": "a state must be a mapping", "input": {"states": {"working": "clouds"}},
     "expect": {"states": {"working": {"pattern": "clouds"}}}, "warnings": [["states.working", "type"]]},
    {"name": "states must be a mapping", "input": {"states": ["working"]},
     "expect": {"states": {"working": {"pattern": "clouds"}}}, "warnings": [["states", "type"]]},
    {"name": "add a pattern", "input": {"patterns": {"dense": {"base": "mottle", "density": 1.5, "contrast": 1.2}}},
     "expect": {"patterns": {"dense": {"base": "mottle", "density": 1.5, "contrast": 1.2, "scale": 1}}}, "warnings": []},
    {"name": "tune a built-in pattern", "input": {"patterns": {"mottle": {"contrast": 1.3}}},
     "expect": {"patterns": {"mottle": {"base": "mottle", "density": 1, "contrast": 1.3, "scale": 1}}}, "warnings": []},
    {"name": "a pattern with an unknown base is dropped", "input": {"patterns": {"bad": {"base": "plaid"}}},
     "expect": {}, "absent": ["patterns.bad"], "warnings": [["patterns.bad.base", "enum"]]},
    {"name": "a new pattern needs a base", "input": {"patterns": {"bad": {"density": 2}}},
     "expect": {}, "absent": ["patterns.bad"], "warnings": [["patterns.bad.base", "missing"]]},
    {"name": "a pattern parameter out of range keeps its default", "input": {"patterns": {"p": {"base": "zebra", "density": 99}}},
     "expect": {"patterns": {"p": {"base": "zebra", "density": 1}}}, "warnings": [["patterns.p.density", "range"]]},
    {"name": "a built-in pattern's base cannot change", "input": {"patterns": {"zebra": {"base": "mottle"}}},
     "expect": {"patterns": {"zebra": {"base": "zebra"}}}, "warnings": [["patterns.zebra.base", "required"]]},
    {"name": "a state may use a user pattern", "input": {"patterns": {"dense": {"base": "mottle"}}, "states": {"needs_you": {"pattern": "dense"}}},
     "expect": {"states": {"needs_you": {"pattern": "dense"}}}, "warnings": []},
    {"name": "a preset pointed at an unknown pattern keeps its own", "input": {"states": {"error": {"pattern": "plaid"}}},
     "expect": {"states": {"error": {"pattern": "blanch"}}}, "warnings": [["states.error.pattern", "unknown"]]},
    {"name": "unknown top-level keys are reported, not fatal", "input": {"colour": "red", "motion": "off"},
     "expect": {"motion": "off"}, "warnings": [["colour", "unknown"]]},
    {"name": "unknown keys inside a state are reported", "input": {"states": {"working": {"hue": 30}}},
     "expect": {"states": {"working": {"pattern": "clouds"}}}, "warnings": [["states.working.hue", "unknown"]]},
    {"name": "everything wrong at once still yields a usable config", "input": {"intensity": "x", "motion": 7, "states": 3, "patterns": "y"},
     "expect": {"intensity": 1, "motion": "still"}, "warnings": [["intensity", "type"], ["motion", "enum"], ["states", "type"], ["patterns", "type"]]}
  ]
}
